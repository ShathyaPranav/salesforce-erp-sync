# Copy to .env (gitignored) and fill in. Never commit .env, never paste these in chat.
#
# Salesforce External Client App, OAuth 2.0 client credentials flow.
# SF_LOGIN_URL must be your org's My Domain URL (Setup > My Domain), NOT
# login.salesforce.com: the client credentials flow is rejected there.
SF_LOGIN_URL=<https://your-domain-dev-ed.develop.my.salesforce.com>
SF_CLIENT_ID=<consumer key from the External Client App>
SF_CLIENT_SECRET=<consumer secret from the External Client App>
SF_API_VERSION=v66.0

# Where CloudWatch alarms are emailed (used by scripts/deploy.py). AWS sends a
# confirmation email after the first deploy: click it within 48 hours.
ALERT_EMAIL=<you@example.com>

# Deliberately NOT here: AWS_PROFILE or any AWS keys. Local code and tests only
# ever talk to the emulator; real AWS is used only from commands you run
# yourself with --profile relay.
